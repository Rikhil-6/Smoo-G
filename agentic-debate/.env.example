# Kimi / Moonshot
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k

# Bright Data
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=serp_api1
BRIGHTDATA_PLAYWRIGHT_WSS=

# Daytona
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# TokenRouter
TOKENROUTER_API_KEY=
TOKENROUTER_DEFAULT_ROUTE=research-heavy

# Public URL for QR codes (use LAN IP for local phone testing)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_QR_BASE_URL=
QR_PUBLIC_URL=
PUBLIC_APP_URL=
DAYTONA_PUBLIC_URL=
# Vercel usually injects these automatically in hosted builds.
VERCEL_URL=
VERCEL_PROJECT_PRODUCTION_URL=
VERCEL_BRANCH_URL=

# Telegram fallback (optional)
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_URL=
NEXT_PUBLIC_TELEGRAM_BOT_URL=
# Server-only. Do not expose as NEXT_PUBLIC_*.
TELEGRAM_BOT_TOKEN=

# API destination used by browser clients.
# Set this to your public backend URL when app and API are separate.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_BACKEND_API_URL=
NEXT_PUBLIC_API_MODE=
BACKEND_API_URL=
